{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eunice Reader",
  "version": "1.2.3",
  "identifier": "com.eunice.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Eunice Reader",
        "width": 1280,
        "height": 860,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "theme": null,
        "decorations": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["acrylic"]
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: asset: http://asset.localhost https:",
        "script-src": "'self'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/file-markdown.ico": "icons/file-markdown.ico"
    },
    "category": "Productivity",
    "shortDescription": "Markdown 阅读器",
    "longDescription": "支持完整 GFM 语法的 Windows Markdown 阅读器，内置多套主题与全量代码高亮配色。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mdwn", "mdtxt", "mdtext", "rmd", "qmd"],
        "name": "Markdown Document",
        "description": "Markdown 文档",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ]
  }
}